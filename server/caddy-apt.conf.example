# APT —— 葡语学习打卡 PWA
#
# ⚠️ 本文件是 **线上 Caddyfile 的实际形态**（2026-10-07 部署后取回）。
#    线上 /etc/caddy/Caddyfile 是**单文件**，lababa / lisa / trends / apt 四个站点共存。
#    追加本块时**只加在末尾，绝不改动已有块**。
#
# 部署步骤：
#   1. sudo cp /etc/caddy/Caddyfile /etc/caddy/Caddyfile.bak-$(date +%Y%m%d-%H%M%S)
#   2. 把下面整块追加到 /etc/caddy/Caddyfile 末尾
#   3. sudo caddy validate --config /etc/caddy/Caddyfile   ← 不通过绝不reload
#   4. sudo systemctl reload caddy
#
# 说明：
# - Caddy 自动签发与续期证书，不需要 ssl_certificate，不需要 certbot
# - lababa.live 已配泛解析 *，apt.example.com 自动解析到本机，无需 A 记录
# - Caddy 无内建限流，日额度由 apt-tts 自身兜底（5000 字符/天）
# - log_skip /api/* 必须有：请求体就是学生输入的学习内容

apt.example.com {
	encode zstd gzip

	root * /var/www/apt
	file_server

	# Service Worker 绝不能进缓存：命中缓存 = 更新最长一天拿不到
	@sw path /sw.js
	header @sw Cache-Control "no-cache, no-store, must-revalidate"

	# 页面与数据：每次回源，保证新课文自动出现
	@data path / /index.html /logic.js /materials.json /manifest.json
	header @data Cache-Control "no-cache"

	# 音频内容不可变，长缓存
	@audio path /audio/*
	header @audio Cache-Control "public, max-age=31536000, immutable"

	# 发音代理：转发到本机8787
	@api path /api/*
	handle @api {
		request_body {
			max_size 1MB
		}
		reverse_proxy 127.0.0.1:8787
	}

	# 必须关闭该路径日志：查询串/请求体就是学生输入的学习内容
	log_skip /api/*
}

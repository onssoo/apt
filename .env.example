# APT 凭据模板。复制为 .env 后填入真实值。
# .env 已在 .gitignore 中，永远不要提交。

# Azure Cognitive Services Speech（必填）
AZURE_KEY=
AZURE_REGION=eastus

# 音色（可选，默认 RaquelNeural）
# 可选值见 docs/DESIGN.md D1：Raquel / Fernanda / Duarte
VOICE=pt-PT-RaquelNeural
# 对话课第二角色，默认 Duarte
VOICE2=pt-PT-DuarteNeural

# 生成慢速音频（M3-6，默认关闭）
# 设为 1 时 sents[].s 会被填充，前端 0.75x 优先播放它
SLOW_AUDIO=0

# 质检阈值（M3-3，词级差异率上限）
QA_THRESHOLD=0.15

# VPS（部署时用，不入 site/）
VPS=ubuntu@203.0.113.10
# 线上域名（deploy.sh 核对 version 用）
SITE_HOST=apt.example.com
VPS_SSH_PORT=2222
# SSH 私钥（deploy.sh 用；没有就留空，走 ~/.ssh/config）
# VPS_SSH_KEY=~/.ssh/your-vps-key.pem
REMOTE_DIR=/var/www/apt